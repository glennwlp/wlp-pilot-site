---
const FOOTER_CONTENT = {
	tagline: "Edited by humans, shipped by software.",
	copyright: "© 2026 WhitelabelPRESS pilot site.",
};
---

<footer class="px-6 py-12 border-t border-slate-200 text-center">
	<p
		data-wlp-source="astro:src/components/Footer.astro:FOOTER_CONTENT.tagline"
		class="text-slate-500 text-sm font-mono uppercase tracking-widest mb-2"
	>
		{FOOTER_CONTENT.tagline}
	</p>
	<p
		data-wlp-source="astro:src/components/Footer.astro:FOOTER_CONTENT.copyright"
		class="text-slate-400 text-xs"
	>
		{FOOTER_CONTENT.copyright}
	</p>
</footer>
