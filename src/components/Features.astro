---
const FEATURES_CONTENT = {
	eyebrow: "How it works",
	headline: "Three ways to edit, all in the same chat.",
	headlineTag: "h2",
	items: [
		{
			title: "Type what you want changed.",
			body: "Describe the edit in plain English. The agent finds the right file or post, makes the change, and opens a PR for you to review.",
			id: "",
			titleTag: "h3",
		},
		{
			title: "Click directly on the page.",
			body: "Hover any heading, paragraph, or image in the preview pane. Click to open an inline editor. Save sends a PR straight to your repo.",
			id: "",
			titleTag: "h3",
		},
		{
			title: "Drop in a comment.",
			body: "Right-click anywhere to leave a note for your team or hand the rewrite to the AI with a single button. Threads stay attached to the page.",
			id: "",
			titleTag: "h3",
		},
	],
};

// Capitalized for Astro's dynamic-tag pattern.
const HeadlineTag = FEATURES_CONTENT.headlineTag as keyof HTMLElementTagNameMap;
---

<section id="how-it-works" class="px-6 py-24 max-w-5xl mx-auto">
	<p class="text-sm font-mono uppercase tracking-widest text-purple-600 mb-6">
		{FEATURES_CONTENT.eyebrow}
	</p>
	<HeadlineTag
		class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-16 max-w-2xl"
		data-wlp-tag-source="astro:src/components/Features.astro:FEATURES_CONTENT.headlineTag"
		data-wlp-tag={FEATURES_CONTENT.headlineTag}
		data-wlp-tag-options="h1,h2,h3,h4,h5,h6,div,span,p"
	>
		{FEATURES_CONTENT.headline}
	</HeadlineTag>

	<div class="grid md:grid-cols-3 gap-12">
		{FEATURES_CONTENT.items.map((item, i) => {
			const ItemTag = item.titleTag as keyof HTMLElementTagNameMap;
			return (
				<div>
					{/* Hand-annotated: the integration's auto-emission can't see closure
					    variables like `item.title` inside .map() — only member chains
					    rooted at a frontmatter const auto-resolve. The picker overlay
					    + writer accept either source. */}
					<ItemTag
						data-wlp-source={`astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].title`}
						data-wlp-id-source={`astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].id`}
						data-wlp-id={item.id}
						data-wlp-tag-source={`astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].titleTag`}
						data-wlp-tag={item.titleTag}
						data-wlp-tag-options="h1,h2,h3,h4,h5,h6,div,span,p"
						id={item.id || undefined}
						class="text-xl font-semibold mb-3"
					>
						{item.title}
					</ItemTag>
					<p
						data-wlp-source={`astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].body`}
						class="text-slate-700 leading-relaxed"
					>
						{item.body}
					</p>
				</div>
			);
		})}
	</div>
</section>
