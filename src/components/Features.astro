---
const FEATURES_CONTENT = {
	eyebrow: "How it works",
	headline: "Three ways to edit, all in the same chat.",
	headlineTag: "h2",
	items: [
		{
			title: "Type what you want changed.",
			body: "Describe the edit in plain English. The agent finds the right file or post, makes the change, and opens a PR for you to review.",
			id: "",
			titleTag: "h3",
			titleAriaLabel: "",
			titleLink: "",
			titleLinkTarget: "",
			bodyId: "",
			bodyTag: "p",
			bodyAriaLabel: "",
			bodyLink: "",
			bodyLinkTarget: "",
		},
		{
			title: "Click directly on the page.",
			body: "Hover any heading, paragraph, or image in the preview pane. Click to open an inline editor. Save sends a PR straight to your repo.",
			id: "",
			titleTag: "h3",
			titleAriaLabel: "",
			titleLink: "",
			titleLinkTarget: "",
			bodyId: "",
			bodyTag: "p",
			bodyAriaLabel: "",
			bodyLink: "",
			bodyLinkTarget: "",
		},
		{
			title: "Drop in a comment.",
			body: "Right-click anywhere to leave a note for your team or hand the rewrite to the AI with a single button. Threads stay attached to the page.",
			id: "",
			titleTag: "h3",
			titleAriaLabel: "",
			titleLink: "",
			titleLinkTarget: "",
			bodyId: "",
			bodyTag: "p",
			bodyAriaLabel: "",
			bodyLink: "",
			bodyLinkTarget: "",
		},
	],
};

const HeadlineTag = FEATURES_CONTENT.headlineTag as keyof HTMLElementTagNameMap;
---

<section id="how-it-works" class="px-6 py-24 max-w-5xl mx-auto">
	<p class="text-sm font-mono uppercase tracking-widest text-purple-600 mb-6">
		{FEATURES_CONTENT.eyebrow}
	</p>
	<HeadlineTag
		class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-16 max-w-2xl"
		data-wlp-tag-source="astro:src/components/Features.astro:FEATURES_CONTENT.headlineTag"
		data-wlp-tag={FEATURES_CONTENT.headlineTag}
		data-wlp-tag-options="h1,h2,h3,h4,h5,h6,div,span,p"
	>
		{FEATURES_CONTENT.headline}
	</HeadlineTag>

	<div class="grid md:grid-cols-3 gap-12">
		{FEATURES_CONTENT.items.map((item, i) => {
			const ItemTag = item.titleTag as keyof HTMLElementTagNameMap;
			const ItemBodyTag = item.bodyTag as keyof HTMLElementTagNameMap;
			const titleProps = {
				"data-wlp-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].title`,
				"data-wlp-id-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].id`,
				"data-wlp-id": item.id,
				"data-wlp-tag-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].titleTag`,
				"data-wlp-tag": item.titleTag,
				"data-wlp-tag-options": "h1,h2,h3,h4,h5,h6,div,span,p",
				"data-wlp-aria-label-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].titleAriaLabel`,
				"data-wlp-aria-label-value": item.titleAriaLabel,
				"data-wlp-link-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].titleLink`,
				"data-wlp-link": item.titleLink,
				"data-wlp-link-target-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].titleLinkTarget`,
				"data-wlp-link-target-value": item.titleLinkTarget,
				id: item.id || undefined,
				"aria-label": item.titleAriaLabel || undefined,
				class: "text-xl font-semibold mb-3",
			};
			const bodyItemProps = {
				"data-wlp-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].body`,
				"data-wlp-id-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].bodyId`,
				"data-wlp-id": item.bodyId,
				"data-wlp-tag-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].bodyTag`,
				"data-wlp-tag": item.bodyTag,
				"data-wlp-tag-options": "p,span",
				"data-wlp-aria-label-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].bodyAriaLabel`,
				"data-wlp-aria-label-value": item.bodyAriaLabel,
				"data-wlp-link-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].bodyLink`,
				"data-wlp-link": item.bodyLink,
				"data-wlp-link-target-source": `astro:src/components/Features.astro:FEATURES_CONTENT.items[${i}].bodyLinkTarget`,
				"data-wlp-link-target-value": item.bodyLinkTarget,
				id: item.bodyId || undefined,
				"aria-label": item.bodyAriaLabel || undefined,
				class: "text-slate-700 leading-relaxed",
			};
			return (
				<div>
					{item.titleLink ? (
						<a
							href={item.titleLink}
							class="text-inherit no-underline"
							target={item.titleLinkTarget === "_blank" ? "_blank" : undefined}
							rel={item.titleLinkTarget === "_blank" ? "noopener noreferrer" : undefined}
						>
							<ItemTag {...titleProps}>{item.title}</ItemTag>
						</a>
					) : (
						<ItemTag {...titleProps}>{item.title}</ItemTag>
					)}
					{item.bodyLink ? (
						<a
							href={item.bodyLink}
							class="text-inherit no-underline"
							target={item.bodyLinkTarget === "_blank" ? "_blank" : undefined}
							rel={item.bodyLinkTarget === "_blank" ? "noopener noreferrer" : undefined}
						>
							<ItemBodyTag {...bodyItemProps}>{item.body}</ItemBodyTag>
						</a>
					) : (
						<ItemBodyTag {...bodyItemProps}>{item.body}</ItemBodyTag>
					)}
				</div>
			);
		})}
	</div>
</section>
