---
import '../../styles/global.css';
import DetailPage from '@whitelabelpress/astro-sections/components/DetailPage.astro';
import MediaGallery from '@whitelabelpress/astro-sections/components/MediaGallery.astro';
import RelatedItems from '@whitelabelpress/astro-sections/components/RelatedItems.astro';
import KeyValueTable from '@whitelabelpress/astro-sections/components/KeyValueTable.astro';
import { getStaticPathsFor } from '@whitelabelpress/astro-sections';
import Footer from '../../components/Footer.astro';

// Per-property route generated at build time. One paths fetch + one
// per-route DetailPage fetch + (when used) one MediaGallery fetch.
const WP_URL = 'https://acss.whitelabelpress.com';

export const getStaticPaths = getStaticPathsFor('property', { wpUrl: 'https://acss.whitelabelpress.com' });

const { slug } = Astro.params;

// MediaGallery + RelatedItems both want a numeric postId. fetchPost (used
// internally by DetailPage) takes a slug; we re-resolve the id once here so
// the gallery + related sections can key off it.
const postRes = await fetch(`${WP_URL}/wp-json/wp/v2/property?slug=${encodeURIComponent(slug ?? '')}&_fields=id`);
const postArr = postRes.ok ? await postRes.json() : [];
const postId = Array.isArray(postArr) && postArr.length > 0 ? postArr[0].id : null;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{slug}</title>
	</head>
	<body class="bg-white text-slate-900 antialiased">
		<main class="mx-auto max-w-4xl px-6 py-12">
			<p class="mb-6 text-xs font-mono uppercase tracking-widest text-slate-500">// PROPERTY_DETAIL</p>

			<DetailPage
				postType="property"
				wpUrl={WP_URL}
				slug={slug ?? ''}
				mapping={{
					hero: {
						image: 'acf.gallery[0]',
						title: 'title.rendered',
						subtitle: 'acf.headline',
						badge: 'acf.listing_price',
					},
					body: 'content.rendered',
				}}
			/>

			{postId !== null && (
				<section class="mt-12 border-t border-slate-200 pt-10">
					<h2 class="text-xl font-semibold tracking-tight">At a glance</h2>
					<div class="mt-6">
						<KeyValueTable
							postType="property"
							wpUrl={WP_URL}
							postId={postId}
							rows={[
								{ label: 'Listing price', field: 'acf.listing_price', format: 'currency' },
								{ label: 'Available from', field: 'acf.availability_date', format: 'date' },
								{ label: 'Headline', field: 'acf.headline', format: 'text' },
							]}
							currency="USD"
							locale="en-US"
						/>
					</div>
				</section>
			)}

			{postId !== null && (
				<section class="mt-16 border-t border-slate-200 pt-10">
					<h2 class="text-xl font-semibold tracking-tight">Gallery</h2>
					<div class="mt-6">
						<MediaGallery
							postType="property"
							wpUrl={WP_URL}
							postId={postId}
							field="acf.gallery"
						/>
					</div>
				</section>
			)}

			{postId !== null && (
				<section class="mt-16 border-t border-slate-200 pt-10">
					<h2 class="text-xl font-semibold tracking-tight">Similar units</h2>
					<div class="mt-6">
						<RelatedItems
							postType="property"
							wpUrl={WP_URL}
							postId={postId}
							field="acf.similar_units"
							renderAs="CollectionList"
							mapping={{
								image: 'acf.gallery[0]',
								title: 'title.rendered',
								badge: 'acf.listing_price',
								body: 'acf.short_description',
							}}
						/>
					</div>
				</section>
			)}
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* DetailPage hero — large image left, heading right (stacks on mobile). */
	.wlp-detail__hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	@media (max-width: 720px) {
		.wlp-detail__hero {
			grid-template-columns: 1fr;
		}
	}
	.wlp-detail__image img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 0.75rem;
	}
	.wlp-detail__heading {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.wlp-detail__badge {
		display: inline-block;
		padding: 0.25rem 0.6rem;
		border-radius: 0.25rem;
		background: rgb(241 245 249);
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(51 65 85);
		width: fit-content;
	}
	.wlp-detail__title {
		font-size: 2rem;
		font-weight: 600;
		margin: 0;
	}
	.wlp-detail__subtitle {
		font-size: 1rem;
		color: rgb(71 85 105);
		margin: 0;
	}
	.wlp-detail__body {
		margin-top: 2rem;
		color: rgb(51 65 85);
		font-size: 1rem;
		line-height: 1.7;
	}
	.wlp-detail__body p {
		margin: 0 0 1em;
	}

	/* KeyValueTable — two-column rows, labels muted, values strong. */
	.wlp-keyvalue {
		display: flex;
		flex-direction: column;
		gap: 0;
		border-top: 1px solid rgb(226 232 240);
	}
	.wlp-keyvalue__row {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.5rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid rgb(226 232 240);
	}
	.wlp-keyvalue__label {
		margin: 0;
		color: rgb(100 116 139);
		font-size: 0.875rem;
	}
	.wlp-keyvalue__value {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(15 23 42);
	}
	@media (max-width: 600px) {
		.wlp-keyvalue__row {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}

	/* MediaGallery — square grid with rounded corners. */
	.wlp-media-gallery__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 0.75rem;
	}
	.wlp-media-gallery__item {
		overflow: hidden;
		border-radius: 0.5rem;
		background: rgb(241 245 249);
	}
	.wlp-media-gallery__image {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
	}

	/* Re-import the feed-item styles from /properties for the related list. */
	.wlp-collection-list__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.wlp-feed-item {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.25rem;
		align-items: start;
		border: 1px solid rgb(226 232 240);
		border-radius: 0.75rem;
		overflow: hidden;
		background: white;
	}
	.wlp-feed-item__image {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.wlp-feed-item__content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem 1rem 1rem 0;
	}
	.wlp-feed-item__title {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
	}
	.wlp-feed-item__link {
		text-decoration: none;
		color: inherit;
	}
	.wlp-feed-item__badge {
		display: inline-block;
		padding: 0.2rem 0.5rem;
		border-radius: 0.25rem;
		background: rgb(241 245 249);
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(51 65 85);
		width: fit-content;
	}
	.wlp-feed-item__body {
		font-size: 0.9rem;
		color: rgb(71 85 105);
		margin: 0;
	}
	@media (max-width: 600px) {
		.wlp-feed-item {
			grid-template-columns: 1fr;
		}
		.wlp-feed-item__content {
			padding: 0 1rem 1rem;
		}
	}
</style>
