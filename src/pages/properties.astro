---
import '../styles/global.css';
import CollectionGrid from '@whitelabelpress/astro-sections/components/CollectionGrid.astro';
import RelatedItems from '@whitelabelpress/astro-sections/components/RelatedItems.astro';
import Footer from '../components/Footer.astro';

const PAGE_META = {
	title: "Properties — WhitelabelPRESS pilot",
	description: "A grid of properties rendered from WordPress via @whitelabelpress/astro-sections — no per-CPT fetch loop.",
};

// Pilot WP — schema-driven render of the `property` CPT seeded by
// `wlp-pilot-property.php`. The grid below is the live verification surface
// for Phase 22 Slice 22B's fetch.ts: one collection fetch (with
// `_embed=wp:featuredmedia`) plus a follow-up media batch for the gallery
// attachment IDs that fall outside the embedded set.
//
// Mapping uses ACF fields populated by the v0.2.0 seed reseed:
//   - acf.gallery[0]         → first gallery image (int ID → fetched via
//                              the missing-media batch → resolved by
//                              asImageUrl against the folded _embedded set)
//   - title.rendered         → card title
//   - acf.listing_price      → badge (raw number; unformatted is fine for
//                              the smoke, currency formatting is a slice 22D
//                              concern via <KeyValueTable format='currency'>)
//   - acf.short_description  → card body (wysiwyg → HTML; rendered via
//                              set:html={} which is already wired in the
//                              primitive)
const WP_URL = "https://acss.whitelabelpress.com";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{PAGE_META.title}</title>
		<meta name="description" content={PAGE_META.description} />
	</head>

	<body class="bg-white text-slate-900 antialiased">
		<main class="mx-auto max-w-6xl px-6 py-16">
			<header class="mb-12">
				<p class="text-xs font-mono uppercase tracking-widest text-slate-500">// COLLECTION_GRID_SMOKE</p>
				<h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Properties</h1>
				<p class="mt-4 max-w-2xl text-lg text-slate-600">
					Schema-driven render of the WordPress <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">property</code> CPT
					via <code class="rounded bg-slate-100 px-1.5 py-0.5 text-sm">@whitelabelpress/astro-sections</code>.
					No per-CPT fetch loop in this file — only a mapping.
				</p>
			</header>

			<CollectionGrid
				postType="property"
				wpUrl={WP_URL}
				limit={10}
				orderBy="date"
				orderDir="desc"
				mapping={{
					image: "acf.gallery[0]",
					title: "title.rendered",
					badge: "acf.listing_price",
					body: "acf.short_description",
				}}
				variant="card-photo-overlay"
				emptyText="No properties yet."
			/>

			<section class="mt-20 border-t border-slate-200 pt-12">
				<p class="text-xs font-mono uppercase tracking-widest text-slate-500">// RELATED_ITEMS_SMOKE</p>
				<h2 class="mt-2 text-2xl font-semibold tracking-tight">Similar units to Sunset Villa</h2>
				<p class="mt-2 max-w-2xl text-sm text-slate-600">
					Cards rendered from <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">acf.similar_units</code> — exercises
					<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">fetchRelatedBatch</code> end-to-end.
				</p>

				<div class="mt-6">
					<RelatedItems
						postType="property"
						wpUrl={WP_URL}
						postId={1183}
						field="acf.similar_units"
						renderAs="CollectionList"
						mapping={{
							image: "acf.gallery[0]",
							title: "title.rendered",
							badge: "acf.listing_price",
							body: "acf.short_description",
						}}
					/>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	/* Minimal variant CSS so the smoke render reads as cards rather than a
	   raw <ul>. Slice 22B's full variant stylesheet ships with the package
	   later; this is a pilot-local override. */
	.wlp-collection-grid__list,
	.wlp-related-items__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.wlp-related-items__empty,
	.wlp-collection-list__empty {
		padding: 4rem 0;
		text-align: center;
		color: rgb(100 116 139);
	}

	/* CollectionList — vertical feed layout. Image left, text right. */
	.wlp-collection-list__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.wlp-feed-item {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.25rem;
		align-items: start;
		border: 1px solid rgb(226 232 240);
		border-radius: 0.75rem;
		overflow: hidden;
		background: white;
	}
	.wlp-feed-item__image {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.wlp-feed-item__content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem 1rem 1rem 0;
	}
	.wlp-feed-item__title {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
	}
	.wlp-feed-item__link {
		text-decoration: none;
		color: inherit;
	}
	.wlp-feed-item__badge {
		display: inline-block;
		padding: 0.2rem 0.5rem;
		border-radius: 0.25rem;
		background: rgb(241 245 249);
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(51 65 85);
		width: fit-content;
	}
	.wlp-feed-item__body {
		font-size: 0.9rem;
		color: rgb(71 85 105);
		margin: 0;
	}
	@media (max-width: 600px) {
		.wlp-feed-item {
			grid-template-columns: 1fr;
		}
		.wlp-feed-item__content {
			padding: 0 1rem 1rem;
		}
	}
	.wlp-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border: 1px solid rgb(226 232 240); /* slate-200 */
		border-radius: 0.75rem;
		overflow: hidden;
		background: white;
	}
	.wlp-card__image {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.wlp-card__title {
		font-size: 1.125rem;
		font-weight: 600;
		margin: 0;
		padding: 0 1rem;
	}
	.wlp-card__link {
		text-decoration: none;
		color: inherit;
	}
	.wlp-card__body {
		font-size: 0.9rem;
		color: rgb(71 85 105); /* slate-600 */
		margin: 0;
		padding: 0 1rem 1rem;
	}
	.wlp-card__badge {
		display: inline-block;
		margin: 0 1rem;
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		background: rgb(241 245 249); /* slate-100 */
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(51 65 85); /* slate-700 */
		width: fit-content;
	}
	.wlp-collection-grid__empty {
		padding: 4rem 0;
		text-align: center;
		color: rgb(100 116 139); /* slate-500 */
	}
</style>
